<?xml version="1.0" encoding="utf-8"?>
<ScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#0F0F12"
     android:fillViewport="true">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:padding="24dp"
         android:orientation="vertical">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginBottom="4dp"
             android:gravity="center_vertical"
             android:orientation="horizontal">

            <ImageView
                 android:layout_height="36dp"
                 android:layout_width="36dp"
                 android:src="@drawable/icon"
                 android:layout_marginEnd="12dp"
                 android:contentDescription="ScreenSeek Logo"
                 android:id="@+id/ivLogo" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="28sp"
                 android:fontFamily="sans-serif-medium"
                 android:textColor="#F3F4F6"
                 android:text="ScreenSeek"
                 android:textStyle="bold" />

        </LinearLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_marginBottom="24dp"
             android:textSize="14sp"
             android:textColor="#9CA3AF"
             android:text="Instant vision snippet assistant." />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginBottom="16dp"
             android:background="@drawable/bg_card"
             android:padding="20dp"
             android:orientation="vertical">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginBottom="8dp"
                 android:textSize="13sp"
                 android:textColor="#9CA3AF"
                 android:text="GEMINI API KEY" />

            <EditText
                 android:layout_height="48dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="14dp"
                 android:background="@drawable/bg_input"
                 android:hint="AIzaSy..."
                 android:textColorHint="#4B5563"
                 android:textSize="14sp"
                 android:textColor="#F3F4F6"
                 android:paddingHorizontal="14dp"
                 android:inputType="textPassword"
                 android:id="@+id/etApiKey" />

            <EditText
                 android:layout_height="0dp"
                 android:layout_width="0dp"
                 android:visibility="gone"
                 android:id="@+id/etModelName" />

            <Button
                 android:layout_height="46dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/bg_btn_secondary"
                 android:textSize="14sp"
                 android:textColor="#FFFFFF"
                 android:id="@+id/btnSaveApiKey"
                 android:text="Save Key"
                 android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginBottom="24dp"
             android:background="@drawable/bg_card"
             android:orientation="vertical">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:clickable="true"
                 android:padding="16dp"
                 android:orientation="horizontal"
                 android:focusable="true"
                 android:id="@+id/layoutApiHelpHeader">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="14sp"
                     android:textColor="#60A5FA"
                     android:layout_weight="1"
                     android:text="HOW TO GET A GEMINI API KEY"
                     android:textStyle="bold" />

                <ImageView
                     android:layout_height="24dp"
                     android:layout_width="24dp"
                     android:src="@drawable/ic_chevron_down"
                     android:contentDescription="Expand instructions"
                     android:id="@+id/ivApiHelpArrow" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:paddingEnd="16dp"
                 android:orientation="vertical"
                 android:paddingBottom="16dp"
                 android:paddingStart="16dp"
                 android:id="@+id/layoutApiHelpContent">

                <View
                     android:layout_height="1dp"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="12dp"
                     android:background="#2D2D35" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="13sp"
                     android:textColor="#D1D5DB"
                     android:lineSpacingExtra="5dp"
                     android:text="ScreenSeek uses your own Gemini API key to analyze the screen snippets you capture. You can create a free API key through Google AI Studio." />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="13sp"
                     android:textColor="#D1D5DB"
                     android:layout_marginTop="12dp"
                     android:lineSpacingExtra="5dp"
                     android:text="1. Open the link below.\n2. Sign in with your Google Account.\n3. Select “Get API key”.\n4. Create a new API key or select an existing project.\n5. Copy the generated API key.\n6. Paste the key into the field above and tap “Save Key”." />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:autoLink="web"
                     android:linksClickable="true"
                     android:textSize="13sp"
                     android:textColor="#60A5FA"
                     android:layout_marginTop="14dp"
                     android:id="@+id/tvAiStudioLink"
                     android:text="https://aistudio.google.com/apikey" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="12sp"
                     android:textColor="#6B7280"
                     android:layout_marginTop="12dp"
                     android:lineSpacingExtra="3dp"
                     android:text="Keep your API key private. Do not share it publicly." />

            </LinearLayout>

        </LinearLayout>

        <Button
             android:layout_height="48dp"
             android:layout_width="match_parent"
             android:layout_marginBottom="12dp"
             android:background="@drawable/bg_btn_secondary"
             android:textSize="14sp"
             android:textColor="#D1D5DB"
             android:id="@+id/btnPermission"
             android:text="Grant Overlay Permission" />

        <Button
             android:layout_height="52dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_btn_primary"
             android:textSize="15sp"
             android:textColor="#FFFFFF"
             android:id="@+id/btnStartSnip"
             android:text="START SCREENSEEK"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="left"
             android:textSize="13sp"
             android:textColor="#6B7280"
             android:layout_marginTop="22dp"
             android:lineSpacingMultiplier="1.2"
             android:text="💡 Pull down your notification shade and add the ScreenSeek Tile for instant 1-tap capture from any app or screen." />

        <Space
             android:layout_height="0dp"
             android:layout_width="match_parent"
             android:layout_weight="1" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginBottom="4dp"
             android:gravity="center"
             android:clickable="true"
             android:textSize="12sp"
             android:textColor="#6B7280"
             android:layout_marginTop="18dp"
             android:focusable="true"
